#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <main-checkout>/../_agent-scratch/<repo-name>/<branch>/<plan-stem>/review-<base7>..<head7>.diff
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3

# Resolve the repo/worktree root. PLAN_FILE can be `-` to mean "no plan; use
# the current directory's repo and the plan-less workspace from sdd-workspace".
if [ "$plan" = "-" ]; then
  repo_root=$(git rev-parse --show-toplevel)
else
  if [[ "$plan" != /* ]]; then
    root=$(git rev-parse --show-toplevel)
    plan="$root/$plan"
  fi
  repo_root=$(cd "$(dirname "$plan")" && git rev-parse --show-toplevel)
  [ -f "$plan" ] || { echo "bad PLAN_FILE: $plan" >&2; exit 2; }
fi

git -C "$repo_root" rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git -C "$repo_root" rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

script_dir="$(cd "$(dirname "$0")" && pwd)"
if [ $# -eq 4 ]; then
  out=$4
else
  if [ "$plan" = "-" ]; then
    dir="$("$script_dir/sdd-workspace")"
  else
    dir="$("$script_dir/sdd-workspace" "$plan")"
  fi
  out="$dir/review-$(git -C "$repo_root" rev-parse --short "$base")..$(git -C "$repo_root" rev-parse --short "$head").diff"
fi

mkdir -p "$(dirname "$out")"

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git -C "$repo_root" log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git -C "$repo_root" diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git -C "$repo_root" diff -U10 "${base}..${head}"
} > "$out"

commits=$(git -C "$repo_root" rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
