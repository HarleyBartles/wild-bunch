{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Iterative review metrics",
  "description": "Evidence file for the iterative review graph. Recorded by the orchestrator at each metrics-track node.",
  "type": "object",
  "required": ["pr", "findings_by_node", "rounds_per_finding", "regressions"],
  "properties": {
    "pr": {
      "type": "object",
      "required": ["branch", "base", "head_sha"],
      "properties": {
        "branch": {"type": "string"},
        "base": {"type": "string"},
        "head_sha": {"type": "string"}
      }
    },
    "findings_by_node": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "properties": {
        "preflight": {"type": "integer", "minimum": 0},
        "lens-dispatch": {"type": "integer", "minimum": 0},
        "lens-security": {"type": "integer", "minimum": 0},
        "lens-skills": {"type": "integer", "minimum": 0},
        "lens-marketplace": {"type": "integer", "minimum": 0},
        "lens-plans": {"type": "integer", "minimum": 0},
        "lens-mesh": {"type": "integer", "minimum": 0},
        "lens-scripts": {"type": "integer", "minimum": 0},
        "lens-triage": {"type": "integer", "minimum": 0},
        "scope-honesty": {"type": "integer", "minimum": 0},
        "reviewer-fixes": {"type": "integer", "minimum": 0},
        "resolved-ledger": {"type": "integer", "minimum": 0},
        "final-strong": {"type": "integer", "minimum": 0},
        "regression-scan": {"type": "integer", "minimum": 0}
      }
    },
    "rounds_per_finding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "lens", "discovered_at_node", "discovered_at_round", "severity"],
        "properties": {
          "finding_id": {"type": "string"},
          "lens": {"type": "string"},
          "discovered_at_node": {"type": "string"},
          "discovered_at_round": {"type": "integer", "minimum": 1},
          "resolved_at_node": {"type": "string"},
          "resolved_at_round": {"type": "integer", "minimum": 1},
          "regression_of": {"type": "string"},
          "regression_class": {"type": "string", "enum": ["same-lens-blast-radius", "cross-lens-blast-radius", "outside-blast-radius"]},
          "contested": {"type": "boolean"},
          "tool_blocked": {"type": "boolean"},
          "fix_round": {"type": "integer", "minimum": 0},
          "severity": {"type": "string", "enum": ["blocking", "important", "minor", "deferred"]}
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fix_for", "new_finding", "discovered_at_node", "discovered_at_round", "regression_class", "severity"],
        "properties": {
          "fix_for": {"type": "string"},
          "new_finding": {"type": "string"},
          "discovered_at_node": {"type": "string"},
          "discovered_at_round": {"type": "integer", "minimum": 1},
          "lens": {"type": "string"},
          "regression_of": {"type": "string"},
          "regression_class": {"type": "string", "enum": ["same-lens-blast-radius", "cross-lens-blast-radius", "outside-blast-radius"]},
          "severity": {"type": "string", "enum": ["blocking", "important", "minor", "deferred"]}
        }
      }
    },
    "current_node": {"type": "string"},
    "previous_node": {"type": "string"},
    "non_trivial_fix": {"type": "boolean"},
    "total_rounds": {"type": "integer", "minimum": 0},
    "total_reviewer_subagent_dispatches": {"type": "integer", "minimum": 0},
    "devin_auto_review_invocations": {"type": "integer", "minimum": 0},
    "findings_discovered_at_fix_nodes": {"type": "integer", "minimum": 0},
    "regressions_introduced": {"type": "integer", "minimum": 0}
  }
}
