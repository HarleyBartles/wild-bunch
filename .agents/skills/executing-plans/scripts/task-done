#!/usr/bin/env bash
# Complete one Native task only after its declared verification passes.
set -euo pipefail

if [ "$#" -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: bash task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
shift 4
script_dir=$(cd "$(dirname "$0")" && pwd)
workspace_scripts=$(cd "$script_dir/../../subagent-workspace/scripts" && pwd)
python_executable=$(bash "$script_dir/resolve-runtime")

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
dir=$("$python_executable" "$workspace_scripts/workspace.py" --apply "$plan")
log="$dir/task-${n}-tests.log"
ledger="$dir/progress.md"

cmd=""
for arg in "$@"; do
  case "$arg" in
    *[[:space:]\"\;\|\&]*) cmd="$cmd '$arg'" ;;
    *) cmd="$cmd $arg" ;;
  esac
done
cmd=${cmd# }

rc=0
"$@" >"$log" 2>&1 || rc=$?
tail -n 5 "$log"
if [ "$rc" -ne 0 ]; then
  echo "task-done: test command exited $rc; Task $n NOT recorded (full output: $log)" >&2
  exit "$rc"
fi

last=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1 || true)
[ -n "$last" ] || last="PASS (no output)"
[ -f "$ledger" ] || printf '# Native execution ledger — plan: %s\n' "$plan" >"$ledger"
line="Task $n: complete (commits $(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 HEAD), tests: $cmd → $last)"
printf '%s\n' "$line" >>"$ledger"
echo "ledger: $line"
