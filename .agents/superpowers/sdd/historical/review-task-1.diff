+        var towns = world.Towns.ToArray();
+        return towns
+            .Select((town, index) =>
             {
-                var (x, y) = TownCoordinates[town.Id.Value];
+                var (x, y) = GetCoordinatesForSlot(index, towns.Length);
                 return new SeedMapTown(town.Id.Value, town.Name, town.Services, x, y);
             })
             .ToArray();
