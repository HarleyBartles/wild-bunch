{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarleyBartles/agent-asset-marketplace/operating-standards-catalog.schema.json",
  "title": "Agent Operating Model standards catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "standards", "migration_surfaces"],
  "properties": {
    "version": { "const": 1 },
    "migration_surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "surfaces", "resources", "check", "apply", "requires"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "resources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "check": { "type": "boolean" },
          "apply": { "type": "boolean" },
          "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "legacy_migration": { "enum": ["infer", "explicit"], "default": "infer" }
        }
      }
    }
  }
}
