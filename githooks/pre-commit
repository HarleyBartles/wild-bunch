#!/usr/bin/env bash
# Validate the exact candidate without applying or staging repository changes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git exports repository-local variables to hooks. Clear them after resolving
# this worktree so nested Git commands honour their own working directory.
unset $(git rev-parse --local-env-vars)

HOSTED_COMMIT="${REPO_STANDARDS_HOSTED_COMMIT:-}"
HEAD_BEFORE=$(git rev-parse HEAD)
TREE_BEFORE=""
UNSTAGED_PATCH=""
EXPECTED_WORKTREE_DIFF=""
INTENT_TO_ADD_PATHS=""
UNTRACKED_STASHED=0
WORKTREE_RESET=0
PATCH_RESTORE_FAILED=0

restore_worktree() {
  local exit_code=$?
  trap - EXIT
  if [ "$WORKTREE_RESET" -eq 1 ]; then
    if [ -n "$INTENT_TO_ADD_PATHS" ] && [ -s "$INTENT_TO_ADD_PATHS" ]; then
      while IFS= read -r -d '' path; do
        rm -f -- "$path"
      done < "$INTENT_TO_ADD_PATHS"
    fi
    if ! git apply --binary --whitespace=nowarn "$UNSTAGED_PATCH"; then
      echo "pre-commit: validation finished but the unstaged patch could not be restored from $UNSTAGED_PATCH" >&2
      exit_code=1
      PATCH_RESTORE_FAILED=1
    fi
  fi
  if [ "$UNTRACKED_STASHED" -eq 1 ]; then
    if ! git stash pop --quiet; then
      echo "pre-commit: validation finished but untracked files could not be restored; recover them from git stash" >&2
      exit_code=1
    fi
  fi
  if [ "$PATCH_RESTORE_FAILED" -eq 0 ]; then
    [ -z "$UNSTAGED_PATCH" ] || rm -f "$UNSTAGED_PATCH"
  fi
  [ -z "$EXPECTED_WORKTREE_DIFF" ] || rm -f "$EXPECTED_WORKTREE_DIFF"
  [ -z "$INTENT_TO_ADD_PATHS" ] || rm -f "$INTENT_TO_ADD_PATHS"
  exit "$exit_code"
}

assert_git_state_unchanged() {
  local current_head current_tree current_diff tracked_changed unstaged untracked
  current_head=$(git rev-parse HEAD)
  current_tree=$(git write-tree)
  if [ "$current_head" != "$HEAD_BEFORE" ] || [ "$current_tree" != "$TREE_BEFORE" ]; then
    echo "pre-commit: check command changed HEAD or the staged candidate" >&2
    return 1
  fi
  unstaged=$(git diff --name-only)
  untracked=$(git ls-files --others --exclude-standard)
  tracked_changed=0
  if [ -n "$EXPECTED_WORKTREE_DIFF" ]; then
    current_diff=$(mktemp)
    git diff --binary --no-ext-diff --full-index -- > "$current_diff"
    if ! cmp -s "$EXPECTED_WORKTREE_DIFF" "$current_diff"; then
      tracked_changed=1
    fi
    rm -f "$current_diff"
  elif [ -n "$unstaged" ]; then
    tracked_changed=1
  fi
  if [ "$tracked_changed" -eq 1 ] || [ -n "$untracked" ]; then
    echo "pre-commit: check command changed the materialized candidate or created untracked files:" >&2
    [ -z "$unstaged" ] || echo "$unstaged" >&2
    [ -z "$untracked" ] || echo "$untracked" >&2
    return 1
  fi
}

HOSTED_MODE=0
if [ -n "$HOSTED_COMMIT" ]; then
  HOSTED_MODE=1
  if git symbolic-ref -q HEAD >/dev/null; then
    echo "pre-commit: hosted parity mode requires a detached checkout" >&2
    exit 1
  fi
  if [ "$(git rev-parse "$HOSTED_COMMIT^{commit}")" != "$HEAD_BEFORE" ]; then
    echo "pre-commit: hosted commit must match detached HEAD" >&2
    exit 1
  fi
  if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo "pre-commit: hosted parity mode requires a clean checkout" >&2
    exit 1
  fi
  TREE_BEFORE=$(git write-tree)
else
  UNSTAGED_PATCH=$(mktemp)
  EXPECTED_WORKTREE_DIFF=$(mktemp)
  INTENT_TO_ADD_PATHS=$(mktemp)
  trap restore_worktree EXIT
  # Save the user's unstaged tracked patch, then materialize the staged tree so
  # every check sees exactly the candidate Git would commit.
  git diff --name-only --diff-filter=A -z -- > "$INTENT_TO_ADD_PATHS"
  git diff --binary --no-ext-diff --full-index -- > "$UNSTAGED_PATCH"
  if [ -s "$UNSTAGED_PATCH" ]; then
    git checkout -- .
    WORKTREE_RESET=1
  fi
  if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    git stash push --quiet --keep-index --include-untracked -m "repo-standards pre-commit untracked snapshot $$"
    UNTRACKED_STASHED=1
  fi
  # Intent-to-add entries are absent from the index tree. Remove their
  # worktree placeholders so checks see the same candidate as git write-tree.
  if [ -s "$INTENT_TO_ADD_PATHS" ]; then
    while IFS= read -r -d '' path; do
      rm -f -- "$path"
    done < "$INTENT_TO_ADD_PATHS"
  fi
  TREE_BEFORE=$(git write-tree)
  git diff --binary --no-ext-diff --full-index -- > "$EXPECTED_WORKTREE_DIFF"
fi

if command -v py >/dev/null 2>&1; then
  PYTHON=(py -3)
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=(python3)
elif command -v python >/dev/null 2>&1; then
  PYTHON=(python)
else
  echo "py, python3, or python not found" >&2
  exit 1
fi

COMMAND_DECLARATION="$REPO_ROOT/.agents/contracts/repo-standards-commands.json"
if [ ! -f "$COMMAND_DECLARATION" ]; then
  echo "pre-commit: missing consumer command declaration: $COMMAND_DECLARATION" >&2
  exit 1
fi

if "${PYTHON[@]}" - "$COMMAND_DECLARATION" "$REPO_ROOT" <<'PY'
import json
import subprocess
import sys

declaration_path, repo_root = sys.argv[1:]
with open(declaration_path, encoding="utf-8") as stream:
    declaration = json.load(stream)
raw = declaration.get("check")
if isinstance(raw, list) and raw and all(isinstance(item, str) for item in raw):
    commands = [raw]
elif (
    isinstance(raw, list)
    and raw
    and all(
        isinstance(command, list)
        and len(command) >= 2
        and all(isinstance(item, str) and item for item in command)
        for command in raw
    )
):
    commands = raw
else:
    raise SystemExit("invalid declared check command")
for command in commands:
    if "--check" not in command:
        raise SystemExit("declared check command is missing --check")
    if command[0] == "@python":
        command = [sys.executable, *command[1:]]
    result = subprocess.run(command, cwd=repo_root)
    if result.returncode:
        raise SystemExit(result.returncode)
PY
then
  CHECK_STATUS=0
else
  CHECK_STATUS=$?
fi

assert_git_state_unchanged

if [ "$HOSTED_MODE" -eq 1 ]; then
  trap - EXIT
fi
exit "$CHECK_STATUS"
