<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WildBunch.Domain\WildBunch.Domain.csproj" />
    <!-- Test-only reference: JournalLogProjectorEquivalenceTests need JournalLogProjector
         from Application. This is a test-boundary exception, not a production dependency. -->
    <ProjectReference Include="..\..\src\WildBunch.Application\WildBunch.Application.csproj" />
    <!-- Test-only reference: GameSessionDevEntropyTests need GameSessionJsonSerializer
         from Persistence. This is a test-boundary exception, not a production dependency. -->
    <ProjectReference Include="..\..\src\WildBunch.Persistence\WildBunch.Persistence.csproj" />
  </ItemGroup>

</Project>